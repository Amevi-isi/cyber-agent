# Dockerfile partagé pour tous les agents MCP SOC DZOLACYBER
# Chaque agent utilise ce même Dockerfile avec une commande différente

FROM python:3.11-slim

WORKDIR /app

# Dépendances système minimales
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Installer les dépendances Python
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copier le code source
COPY agents/ agents/

# Healthcheck générique (chaque service surcharge l'URL)
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:${MCP_PORT:-8001}/health || exit 1

# Par défaut: agent_detection (surchargé dans docker-compose)
CMD ["python", "agents/agent_detection/server.py"]
